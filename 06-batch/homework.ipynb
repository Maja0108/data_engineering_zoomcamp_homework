zones_df = spark.read \
    .option("header", "true") \
    .csv("work/taxi_zone_lookup.csv")

zones_df.createOrReplaceTempView("zones")


spark.sql("SELECT * FROM zones LIMIT 5").show()

pickup_counts = df.groupBy("PULocationID").count()
joined_df = pickup_counts.join(zones_df, pickup_counts.PULocationID==zones_df.LocationID)
joined_df.show(5)
result = joined_df.orderBy("count").select("Zone", "count").limit(1)
result.show()
